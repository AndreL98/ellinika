{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://logos.app/schema/item.schema.json",
  "title": "Item texts of one learning language (<lang>.json)",
  "description": "Texts, transliteration, pronunciation, source and review status per item ID. See docs/APP.md section 6.2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["lang", "script", "dir", "items"],
  "properties": {
    "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
    "script": { "type": "string", "pattern": "^[A-Z][a-z]{3}$", "description": "ISO 15924 code, e.g. Grek, Cyrl, Cyrs, Arab, Syrc." },
    "dir": { "enum": ["ltr", "rtl"] },
    "items": {
      "type": "object",
      "propertyNames": { "$ref": "pack.schema.json#/definitions/id" },
      "additionalProperties": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "reviewFlag": {
      "enum": ["ai_suggestion", "verified"],
      "description": "Missing means ai_suggestion. Only a native speaker sets verified."
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source", "status"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "translit": { "type": "string" },
        "translit_status": { "$ref": "#/definitions/reviewFlag" },
        "pron": {
          "type": "object",
          "description": "Pronunciation hint per UI language.",
          "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "pron_status": { "$ref": "#/definitions/reviewFlag" },
        "audio": { "type": ["string", "null"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "url": { "type": "string" },
            "section": { "type": "string" }
          }
        },
        "status": { "enum": ["draft", "reviewed", "approved"] },
        "reviewed_by": { "type": "string" },
        "reviewed_at": { "type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
