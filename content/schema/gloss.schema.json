{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://logos.app/schema/gloss.schema.json",
  "title": "Explanations in one UI language (gloss/<ui-lang>.json)",
  "description": "Meaning, note and source per item ID, plus unit titles. No explanation without a source. See docs/APP.md section 6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lang",
    "items"
  ],
  "properties": {
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "items": {
      "type": "object",
      "propertyNames": {
        "$ref": "pack.schema.json#/definitions/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "meaning",
          "source",
          "status"
        ],
        "properties": {
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          },
          "source": {
            "$ref": "item.schema.json#/definitions/item/properties/source"
          },
          "status": {
            "enum": [
              "draft",
              "reviewed",
              "approved"
            ]
          },
          "reviewed_by": {
            "type": "string"
          },
          "reviewed_at": {
            "type": "string",
            "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "units": {
      "type": "object",
      "description": "Unit titles in this UI language, keyed by unit ID.",
      "propertyNames": {
        "$ref": "pack.schema.json#/definitions/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
