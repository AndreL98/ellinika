{
  "name": "logos",
  "private": true,
  "version": "0.2.0",
  "description": "Free, open-source learning app for Orthodox prayers and terms, plus everyday Greek and Russian.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "build:review": "vite build --config app/vite.config.ts --mode review",
    "preview": "vite preview --config app/vite.config.ts --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "vitest run --config app/vite.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run validate:content && npm run test && npm run build && npm run build:e2e && npm run test:e2e",
    "build:e2e": "vite build --config app/vite.config.ts --mode e2e",
    "preview:e2e": "vite preview --config app/vite.config.ts --mode e2e --port 4173 --strictPort"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
